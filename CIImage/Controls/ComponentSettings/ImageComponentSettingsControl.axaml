<ci:ComponentBase x:Class="CIImage.Controls.ComponentSettings.ImageComponentSettingsControl"
                  x:TypeArguments="componentSettingsModel:ImageComponentSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  xmlns:local="clr-namespace:CIImage.Controls.ComponentSettings"
                  xmlns:componentSettingsModel="clr-namespace:CIImage.Models.ComponentSettings"
                  mc:Ignorable="d">
    <ScrollViewer
        DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ImageComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro">
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI ImageRegular}}"
                                         Header="图片路径"
                                         Description="图片的绝对路径">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox MinWidth="180" MaxWidth="360"
                                 Margin="0 0 2 0"
                                 VerticalAlignment="Center"
                                 Text="{ReflectionBinding Settings.ImagePath}" />
                        
                        <Button Click="On_OpenFile"
                                Padding="8,6,8,6"
                                Content="{ci:FluentIcon {ci:FI FolderOpenRegular}}"
                                FontSize="18" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI SquareRegular}}"
                                         Header="圆角半径"
                                         Description="图片的圆角半径">
                <controls:FASettingsExpander.Footer>
                    <Slider Width="180" Minimum="0" Maximum="18"
                            VerticalAlignment="Center"
                            Classes="auto-tooltip"
                            Value="{ReflectionBinding Settings.CornerRadius}"
                            TickFrequency="1"
                            TickPlacement="None"
                            IsSnapToTickEnabled="True" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                未在 Android 测试，不保证能正常显示图片（？）
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>