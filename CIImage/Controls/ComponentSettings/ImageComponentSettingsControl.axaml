<ci:ComponentBase x:Class="CIImage.Controls.ComponentSettings.ImageComponentSettingsControl"
                  x:TypeArguments="componentSettingsModel:ImageComponentSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  xmlns:local="clr-namespace:CIImage.Controls.ComponentSettings"
                  xmlns:componentSettingsModel="clr-namespace:CIImage.Models.ComponentSettings"
                  xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
                  xmlns:converters="clr-namespace:CIImage.Shared.Converters"
                  mc:Ignorable="d">
    <ci:ComponentBase.Resources>
        <converters:CornerRadiusConverter x:Key="CornerRadiusConverter" />
    </ci:ComponentBase.Resources>

    <ScrollViewer
        DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ImageComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro">
            <fa:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI ImageRegular}}"
                                   Header="图片路径"
                                   Description="图片的绝对路径">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox MinWidth="180" MaxWidth="360"
                                 Margin="0 0 2 0"
                                 VerticalAlignment="Center"
                                 Text="{ReflectionBinding Settings.ImagePath}" />

                        <Button Click="On_OpenFile"
                                Padding="8,6,8,6"
                                Content="{ci:FluentIcon {ci:FI FolderOpenRegular}}"
                                FontSize="18" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
                
                <fa:FASettingsExpanderItem Content="内置图片"
                                           Description="从应用内置资源加载的图片。">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox x:Name="PresetComboBox"
                                      ItemsSource="{Binding PresetImageList}"
                                      SelectedValueBinding="{Binding Value}"
                                      MaxDropDownHeight="360"
                                      Width="240">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Key}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <Button Content="应用预设"
                                    Command="{Binding ApplyPresetCommand}"
                                    CommandParameter="{Binding #PresetComboBox.SelectedValue}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI SquareRegular}}"
                                   Header="圆角半径"
                                   Description="图片的圆角半径">
                <fa:FASettingsExpander.Footer>
                    <Slider Width="180" Minimum="0" Maximum="18"
                            VerticalAlignment="Center"
                            Classes="auto-tooltip"
                            Value="{ReflectionBinding Settings.CornerRadius}"
                            TickFrequency="1"
                            TickPlacement="None"
                            IsSnapToTickEnabled="True" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI ImageEditRegular}}"
                                   Header="图片矩形调整"
                                   Description="调整图片的矩形参数（包括缩放和偏移），点击「应用更改」以保存。">
                <fa:FASettingsExpander.Footer>
                    <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                        实验性功能。不保证稳定
                    </TextBlock>
                </fa:FASettingsExpander.Footer>

                <Grid ColumnDefinitions="Auto *" ColumnSpacing="4">
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Viewbox Height="360" HorizontalAlignment="Center">
                            <Panel Height="120" Width="200">
                                <ZoomBorder x:Name="ZoomBorder"
                                            Height="38" Width="38"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            EnableGestureRotation="False"
                                            PanButton="Left">
                                    <asyncImageLoader:AdvancedImage Width="38" Height="38"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{ReflectionBinding Settings.ImagePath}" />
                                </ZoomBorder>

                                <Border Width="46" Height="46"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        BorderThickness="4"
                                        CornerRadius="{ReflectionBinding Settings.ZoomingCornerRadius, Converter={StaticResource CornerRadiusConverter}}"
                                        IsHitTestVisible="False" />
                                
                                <Image Width="56" Height="56"
                                       Margin="0 0 2.5 3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Source="avares://CIImage/Assets/TravelFriendJoin.png"
                                       IsVisible="{Binding Settings.ShowTravelFriendJoin}" />
                            </Panel>
                        </Viewbox>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <StackPanel Orientation="Vertical" Margin="8" Spacing="4">
                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                <Button Click="ApplyChange_OnClick" Classes="accent">
                                    <ci:IconText Glyph="{ci:FI CheckmarkRegular}" Text="应用更改" />
                                </Button>

                                <Button Click="RevertChange_OnClick"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                    <ci:IconText Glyph="{ci:FI ArrowUndoRegular}" Text="撤销更改" />
                                </Button>
                            </WrapPanel>

                            <Separator />

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding #ZoomBorder.ZoomX, StringFormat='当前缩放: {0:0.00}'}" />

                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                <Button Command="{Binding #ZoomBorder.ZoomInCommand}">
                                    <ci:IconText Glyph="{ci:FI ZoomInRegular}" Text="放大" />
                                </Button>

                                <Button Command="{Binding #ZoomBorder.ZoomOutCommand}">
                                    <ci:IconText Glyph="{ci:FI ZoomOutRegular}" Text="缩小" />
                                </Button>

                                <Button Command="{Binding #ZoomBorder.ResetCommand}">
                                    <ci:IconText Glyph="{ci:FI ArrowResetRegular}" Text="重置矩形" />
                                </Button>
                            </WrapPanel>

                            <Separator />

                            <TextBlock TextWrapping="Wrap">
                                由于技术原因，请通过蓝框中间的区域或图片来拖动。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </fa:FASettingsExpander>

            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                未在 Android 测试，不保证能正常显示图片（？）
            </TextBlock>
            
            <Expander HorizontalAlignment="Left">
                <Expander.Styles>
                    <Style Selector="Expander /template/ ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Name="Root" Height="20" Background="Transparent" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Expander.Styles>
                
                <StackPanel Spacing="4">
                    <ToggleSwitch OnContent="旅行伙伴加入喽！Welcome to maimai world!"
                                  OffContent="显示「旅行伙伴加入」？"
                                  IsChecked="{Binding Settings.ShowTravelFriendJoin}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontStyle="Italic">
                        讲个笑话：lrsgzs 玩 mai2 总时间才 15min（
                    </TextBlock>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>