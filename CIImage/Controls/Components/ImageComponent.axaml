<ci:ComponentBase x:Class="CIImage.Controls.Components.ImageComponent"
                  x:TypeArguments="componentSettings:ImageComponentSettingsControl"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
                  xmlns:componentSettings="clr-namespace:CIImage.Controls.ComponentSettings"
                  xmlns:converters="clr-namespace:CIImage.Shared.Converters"
                  xmlns:local="clr-namespace:CIImage.Controls.Components">
    <ci:ComponentBase.Resources>
        <converters:CornerRadiusConverter x:Key="CornerRadiusConverter" />
    </ci:ComponentBase.Resources>

    <Grid VerticalAlignment="Center"
          DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ImageComponent}}">
        <StackPanel Orientation="Horizontal" Margin="0 2 0 2">
            <Border
                CornerRadius="{ReflectionBinding Settings.CornerRadius, Converter={StaticResource CornerRadiusConverter}}"
                ClipToBounds="True">
                <asyncImageLoader:AdvancedImage Source="{ReflectionBinding Settings.ImagePath}" />
            </Border>
        </StackPanel>
    </Grid>
</ci:ComponentBase>